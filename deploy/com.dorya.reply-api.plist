<?xml version="1.0" encoding="UTF-8"?>
<!--
  맥북이 재부팅돼도 답글 생성기가 계속 뜨게 하려면:
    cp deploy/com.dorya.reply-*.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.dorya.reply-api.plist
    launchctl load ~/Library/LaunchAgents/com.dorya.reply-tunnel.plist
  되돌리기: launchctl unload ~/Library/LaunchAgents/com.dorya.reply-*.plist
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.dorya.reply-api</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/heeeione/PycharmProjects/analyze-review/.venv/bin/python</string>
    <string>-m</string><string>uvicorn</string>
    <string>backend.main:app</string>
    <string>--host</string><string>127.0.0.1</string>
    <string>--port</string><string>8011</string>
  </array>
  <key>WorkingDirectory</key><string>/Users/heeeione/PycharmProjects/analyze-review</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/dorya-reply-api.log</string>
  <key>StandardErrorPath</key><string>/tmp/dorya-reply-api.err</string>
</dict>
</plist>
