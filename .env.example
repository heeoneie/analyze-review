GOOGLE_API_KEY=your_google_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# LLM provider: "google" (로컬, 구글 버짓 사용) or "openai" (배포, 기본값)
LLM_PROVIDER=openai

# 리뷰 답글 생성기 (외식업 배달앱)
STORE_NAME=도야짬뽕 부천시청점
REPLY_LLM_MODEL=gpt-4.1-mini
# 공개 URL 남용 방지용 접속 코드. 비워 두면 잠그지 않는다.
# HTTP 헤더로 전송되므로 ASCII 만 가능하다 (한국어 불가). 예: doya-1877
ACCESS_CODE=
