GOOGLE_API_KEY=your_google_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# LLM provider: "google" (로컬, 구글 버짓 사용) or "openai" (배포, 기본값)
LLM_PROVIDER=openai

# 리뷰 답글 생성기 (외식업 배달앱)
# 실제 매장 이름은 .env 에만 둔다. 공개 저장소인 여기에는 넣지 않는다.
STORE_NAME=우리 매장
REPLY_LLM_MODEL=gpt-4.1-mini
# 공개 URL 남용 방지용 접속 코드. 비워 두면 잠그지 않는다.
# HTTP 헤더로 전송되므로 ASCII 만 가능하다 (한국어 불가). 예: doya-1877
ACCESS_CODE=

# ── 계정 (카카오 로그인) ──
# developers.kakao.com 에서 앱 생성 후 발급. 셋 다 있어야 로그인이 켜진다.
# 없으면 로그인 라우터가 503 을 내고 ACCESS_CODE 경로로만 동작한다.
KAKAO_REST_API_KEY=
KAKAO_REDIRECT_URI=
# 세션 쿠키 서명 키. 바뀌면 로그인한 사람이 전부 로그아웃된다.
# python -c "import secrets;print(secrets.token_urlsafe(32))" 로 생성
SESSION_SECRET=
